# Select .env.staging (default) or .env.production at process startup.
# Set this in the shell/deployment environment, not inside an env file.
# ASTRYD_ENV=staging
REQUIRE_EMAIL_VERIFICATION_FOR_PUBLISH=true

# Flask
FLASK_ENV=development
SECRET_KEY=your-64-character-random-secret-key-here
JWT_SECRET_KEY=your-64-character-random-jwt-secret-key-different-from-above

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/astryd?retryWrites=true&w=majority

# CORS
CORS_ORIGINS=http://localhost:5173

# Redis + Celery (required for email/SMS notifications)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Finix sandbox card payments (never expose these values to the frontend)
FINIX_API_URL=https://finix.sandbox-payments-api.com
FINIX_API_USERNAME=
FINIX_API_PASSWORD=
FINIX_MERCHANT_ID=
FINIX_WEBHOOK_SIGNING_KEY=
FINIX_WEBHOOK_BEARER_TOKEN=
FINIX_WEBHOOK_MAX_AGE_SECONDS=300

# Prices are integer USD cents / basis points
RESERVATION_DEPOSIT_PER_GUEST_CENTS=2500
# Optional server-side override for every Finix charge. Use 100 for $1.00
# testing, or leave empty to charge the normally calculated amount.
PAYMENT_AMOUNT_OVERRIDE_CENTS=
ORDER_TAX_BASIS_POINTS=850
ORDER_DELIVERY_FEE_CENTS=1500

# Multi-tenant routing and account delivery
# Use a separate database for staging; leave blank to use the database in MONGO_URI.
MONGO_DATABASE=
PLATFORM_DOMAIN=
PLATFORM_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ASTRYD_MAIN_API_URL=
ASTRYD_MAIN_SYNC_SECRET=
